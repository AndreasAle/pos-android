<?xml version="1.0" encoding="utf-8"?>
<!--
    Mengizinkan HTTP (non-HTTPS) untuk jaringan lokal.
    Jika sudah pakai domain HTTPS di production, file ini bisa dibiarkan atau dikosongkan.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system"/>
        </trust-anchors>
    </base-config>
</network-security-config>
