<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- POS Web App -->
    <WebView
        android:id="@+id/webView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"/>

    <!-- Loading Screen — long-press untuk ganti URL -->
    <LinearLayout
        android:id="@+id/loadingLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:background="#059669"
        android:clickable="true"
        android:longClickable="true">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🛒"
            android:textSize="56sp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="POS Kasir"
            android:textColor="#ffffff"
            android:textSize="28sp"
            android:fontFamily="sans-serif-medium"
            android:layout_marginTop="12dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Memuat aplikasi..."
            android:textColor="#a7f3d0"
            android:textSize="14sp"
            android:layout_marginTop="6dp"/>

        <ProgressBar
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginTop="24dp"
            android:indeterminateTint="#ffffff"/>

        <!-- Hint long-press -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⚙ Tahan lama untuk menu admin"
            android:textColor="#6ee7b7"
            android:textSize="11sp"
            android:layout_marginTop="40dp"/>

    </LinearLayout>

    <!-- Error Screen -->
    <LinearLayout
        android:id="@+id/errorLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="gone"
        android:background="#111827"
        android:padding="40dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⚠"
            android:textSize="56sp"
            android:textColor="#fbbf24"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tidak dapat terhubung ke server"
            android:textColor="#f9fafb"
            android:textSize="20sp"
            android:fontFamily="sans-serif-medium"
            android:layout_marginTop="16dp"
            android:gravity="center"/>

        <TextView
            android:id="@+id/serverUrlText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#6b7280"
            android:textSize="13sp"
            android:fontFamily="monospace"
            android:layout_marginTop="8dp"
            android:gravity="center"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Pastikan:\n• Server Laravel menyala  (php artisan serve --host=0.0.0.0)\n• Tablet terhubung WiFi yang sama\n• Alamat IP sudah benar"
            android:textColor="#9ca3af"
            android:textSize="14sp"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:lineSpacingMultiplier="1.5"/>

        <!-- Tombol aksi -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="32dp"
            android:gravity="center">

            <Button
                android:id="@+id/changeUrlButton"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:text="⚙ Admin"
                android:layout_marginEnd="12dp"
                android:backgroundTint="#374151"
                android:textColor="#f9fafb"
                android:fontFamily="sans-serif-medium"
                android:stateListAnimator="@null"/>

            <Button
                android:id="@+id/wifiButton"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:text="📶 WiFi"
                android:layout_marginEnd="12dp"
                android:backgroundTint="#374151"
                android:textColor="#f9fafb"
                android:fontFamily="sans-serif-medium"
                android:stateListAnimator="@null"/>

            <Button
                android:id="@+id/retryButton"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:text="↺ Coba Lagi"
                android:backgroundTint="#059669"
                android:textColor="#ffffff"
                android:fontFamily="sans-serif-medium"
                android:stateListAnimator="@null"/>

        </LinearLayout>

    </LinearLayout>

    <!-- Print status — shows the moment Cetak is tapped, so the cashier knows it registered -->
    <TextView
        android:id="@+id/printStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="16dp"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:background="@drawable/print_status_bg"
        android:textColor="#ffffff"
        android:textSize="16sp"
        android:fontFamily="sans-serif-medium"
        android:elevation="8dp"
        android:visibility="gone"/>

</FrameLayout>
